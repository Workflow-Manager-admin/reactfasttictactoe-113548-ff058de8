n, draw)"}},"type":"object","required":["game"],"title":"MakeMoveResponse"},"ResetGameResponse":{"properties":{"game":{"$ref":"#/components/schemas/GameState"}},"type":"object","required":["game"],"title":"ResetGameResponse"},"StartGameResponse":{"properties":{"game":{"$ref":"#/components/schemas/GameState"}},"type":"object","required":["game"],"title":"StartGameResponse"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"},"WinnerResponse":{"properties":{"status":{"type":"string","enum":["in_progress","won","draw"],"title":"Status"},"winner":{"anyOf":[{"type":"string","enum":["X","O"]},{"type":"null"}],"title":"Winner"}},"type":"object","required":["status","winner"],"title":"WinnerResponse"}}},"tags":[{"name":"TicTacToe","description":"Tic Tac Toe game endpoints"}]}