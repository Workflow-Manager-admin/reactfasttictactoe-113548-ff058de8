{"openapi":"3.1.0","info":{"title":"Tic Tac Toe Backend API","description":"FastAPI backend providing REST endpoints to manage Tic Tac Toe game logic and state.","version":"1.0.0"},"paths":{"/":{"get":{"tags":["Health"],"summary":"Health check endpoint","description":"Simple health check endpoint.","operationId":"health_check__get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/game/start":{"post":{"tags":["TicTacToe"],"summary":"Start a new Tic Tac Toe game","description":"Starts a new game, resets the board and first player to 'X'.","operationId":"start_game_game_start_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/StartGameResponse"}}}}}}},"/game/state":{"get":{"tags":["TicTacToe"],"summary":"Get current game board state","description":"Fetch the current Tic Tac Toe 3x3 board state, current player, status, and winner (if any).","operationId":"get_game_state_game_state_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/GameState"}}}}}}},"/game/move":{"post":{"tags":["TicTacToe"],"summary":"Make a move on the game board","description":"Provide a row and column to make a move as the current player. Returns the new state and message if invalid.","operationId":"make_move_game_move_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/MakeMoveRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"$ref":"#/components/schemas/MakeMoveResponse"}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/game/winner":{"get":{"tags":["TicTacToe"],"summary":"Get winner/draw status","description":"Returns if the game has a winner or is a draw, or still in progress."